@startuml
title Architecture Technique – CoreService V3 (Exécution locale + CI/CD + Registry)

' ============================
'   BLOC 1 : POSTE DEV LOCAL
' ============================
node "Poste Développeur\nWindows 10/11" as Dev {

  node "Docker Desktop\n(Moteur Docker)" as DockerLocal {
    component "Container CoreService\n(Image Docker durcie JRE 21)" as LocalContainer
  }

  component "Postman\n(Appels REST)" as Postman
  component "Git (CLI / GUI)" as GitLocal
}

' ============================
'   BLOC 2 : REGISTRY GHCR
' ============================
cloud "GitHub Container Registry (GHCR)" as GHCR {
  component "Image Docker durcie\ncoreservice:latest\n(digest immuable)" as ImageGHCR
}

' ============================
'   BLOC 3 : GITHUB ACTIONS (CI/CD)
' ============================
node "GitHub Actions\n(Cloud CI/CD)" as CI {

  node "VM GitHub Actions\n(Ubuntu Runner)" as Runner {

    component "Moteur Docker\n(préinstallé)" as DockerCI

    component "Container CoreService (exécution CI)\n- Run image\n- Healthcheck /actuator/health\n- Stop & Remove" as CIContainer

    component "Pipeline CI/CD V3\n(build → test → SAST → SBOM → SCA → image → scan → run → smoke test → cleanup → push)" as Pipeline
  }

  component "Repository Git" as Repo
}

' ============================
'   BLOC 4 : SONARCLOUD
' ============================
cloud "SonarCloud\n(Analyse SAST externe)" as Sonar {
  component "Quality Gate\n& tableaux de bord" as SonarQG
}

' ============================
'   FLUX TECHNIQUES
' ============================

' --- Flux Dev ---
Postman --> LocalContainer : Requêtes HTTP/REST
LocalContainer --> Postman : Réponses JSON

GitLocal --> Repo : Push / Pull / PR
Repo --> GitLocal : Code / Historique

' --- Flux CI/CD ---
Repo --> Pipeline : Déclenchement CI\nsur push/PR

Pipeline --> DockerCI : Build Dockerfile\n(image durcie)
DockerCI --> CIContainer : Run container\n+ Healthcheck
CIContainer --> Pipeline : Statut healthy/unhealthy
Pipeline --> CIContainer : Stop & Remove

Pipeline --> DockerCI : Scan image\n(Trivy)
Pipeline --> DockerCI : Scan SBOM\n(Trivy)

Pipeline --> Sonar : Analyse SAST\n(mvn sonar:sonar)
Sonar --> Pipeline : Résultats / Quality Gate

DockerCI --> ImageGHCR : Push image\ncoreservice:latest

' --- Flux Exécution Locale ---
ImageGHCR --> DockerLocal : Pull image\ncoreservice:latest
DockerLocal --> LocalContainer : Démarrage container

@enduml