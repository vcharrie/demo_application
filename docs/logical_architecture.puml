@startuml
title CoreService – Logical Architecture v3

skinparam rectangleStyle rounded
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam packageStyle rectangle
skinparam dpi 150

left to right direction

package "API Layer" {
  rectangle "ResourceController"
  rectangle "ResourceRequest /\nResourceResponse"
  rectangle "GlobalExceptionHandler\n(sanitized errors)"
  rectangle "🆕 ValidationErrorMapper"
  rectangle "🆕 SecurityErrorMapper"
}

package "Service Layer" {
  rectangle "ResourceService"
  rectangle "ResourceServiceImpl\n🆕 Security enforcement\n(UUID validation)"
}

package "Domain Layer" {
  rectangle "Resource"
  rectangle "DomainException"
}

package "Infrastructure Layer" {
  rectangle "ResourceRepository"
  rectangle "ResourceRepositoryImpl"
  rectangle "ResourceEntity"
}

package "🆕 Security & Config Layer" {
  rectangle "SecretsConfigValidator\n(fail-fast)"
  rectangle "SecurityConfig"
  rectangle "LoggingSecurityRules\n(no sensitive data)"
}

package "Tests" {
  rectangle "ResourceControllerTest"
  rectangle "ResourceServiceTest"
  rectangle "ResourceRepositoryTest"
  rectangle "🆕 SecurityTests\n(UUID, secrets, errors)"
}

@enduml
